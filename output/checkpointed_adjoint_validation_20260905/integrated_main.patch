+function _mmgnlse_validate_adjoint_mode(mode)
+    selected = mode isa Symbol ? mode : Symbol(mode)
+    selected in (:continuous, :discrete_rk4ip) || throw(ArgumentError(
+        "adjoint_mode must be :continuous or :discrete_rk4ip; got " *
+        "$(repr(selected))."))
+    return selected
+end
